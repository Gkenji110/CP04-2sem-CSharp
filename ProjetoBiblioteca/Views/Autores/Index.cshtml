@model List<Autor>

<h1>Autores</h1>

<a class="btn" asp-action="Create">+ Novo Autor</a>

<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Nacionalidade</th>
            <th>Livros</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Nome</td>
                <td>@autor.Nacionalidade</td>
                <td>
                    @foreach (var item in autor.AutoresLivros)
                    {
                        <span class="tag">@item.Livro.Titulo</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@autor.Id">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@autor.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@autor.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>

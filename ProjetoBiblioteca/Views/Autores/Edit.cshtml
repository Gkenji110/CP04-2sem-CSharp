@model Autor

<h1>Editar Autor</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" />
    </div>

    <div class="form-group">
        <label>Nacionalidade</label>
        <input asp-for="Nacionalidade" />
    </div>

    <div class="form-group">
        <label>Livros</label>
        <select name="livrosSelecionados" multiple size="6">
            @foreach (var livro in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Livros)
            {
                <option value="@livro.Value" selected="@livro.Selected">@livro.Text</option>
            }
        </select>
        <small>Segure Ctrl (ou Cmd) para selecionar mais de um livro. Desmarque para desassociar.</small>
    </div>

    <button type="submit" class="btn">Salvar</button>
    <a asp-action="Index">Cancelar</a>
</form>

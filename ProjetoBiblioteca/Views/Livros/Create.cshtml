@model Livro

<h1>Novo Livro</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Título</label>
        <input asp-for="Titulo" />
        <span asp-validation-for="Titulo" style="color:red"></span>
    </div>

    <div class="form-group">
        <label>Ano de Publicação</label>
        <input asp-for="AnoPublicacao" type="number" />
    </div>

    <div class="form-group">
        <label>Editora</label>
        <input asp-for="Editora" />
    </div>

    <div class="form-group">
        <label>Autores</label>
        <select name="autoresSelecionados" multiple size="6">
            @foreach (var autor in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Autores)
            {
                <option value="@autor.Value">@autor.Text</option>
            }
        </select>
        <small>Segure Ctrl (ou Cmd) para selecionar mais de um autor.</small>
    </div>

    <button type="submit" class="btn">Salvar</button>
    <a asp-action="Index">Cancelar</a>
</form>
